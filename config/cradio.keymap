#undef ZMK_BEHAVIORS_KEEP_ALL

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define NUM_L 1
#define SYM_L 2
#define NAV_L 3

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick-tap-ms = <200>; };

/ {
    combos {
        compatible = "zmk,combos";
        combo_bt0 {
            timeout-ms = <50>;
            key-positions = <0 20>;
            bindings = <&bt BT_SEL 0>;
            layers = <0>;
        };
        combo_bt1 {
            timeout-ms = <50>;
            key-positions = <1 21>;
            bindings = <&bt BT_SEL 1>;
            layers = <0>;
        };
        combo_bt2 {
            timeout-ms = <50>;
            key-positions = <2 22>;
            bindings = <&bt BT_SEL 2>;
            layers = <0>;
        };
        combo_bt3 {
            timeout-ms = <50>;
            key-positions = <3 23>;
            bindings = <&bt BT_SEL 3>;
            layers = <0>;
        };
        combo_btc {
            timeout-ms = <50>;
            key-positions = <4 24>;
            bindings = <&bt BT_CLR>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        wakeup-source;

        default_layer {
            bindings = <
                &kp MINUS  &kp Y      &kp O       &kp U          &kp Q         &kp Z            &kp R          &kp D       &kp W      &kp UNDER
                &mt LGUI C &mt LALT I &mt LSHFT E &mt LCTRL A    &mt GLOBE G   &mt GLOBE P      &mt RCTRL N    &mt RSHFT T &mt RALT S &mt RGUI M
                &kp B      &kp X      &kp J       &kp K          &kp BSPC      &kp TAB          &kp H          &kp L       &kp F      &kp V
                                                  &mt LSHFT SPACE &mo NUM_L    &mo SYM_L        &mt RCTRL ENTER
            >;
        };

        num_layer {
            bindings = <
                &kp N1     &kp N2     &kp N3      &kp N4          &kp N5        &kp N6          &kp N7         &kp N8      &kp N9     &kp N0
        &mt LGUI MINUS &mt LALT ESC &mt LSHFT GRAVE &mt LCTRL SQT &kp COMMA     &kp PERIOD      &mt RCTRL DQT  &mt RSHFT HASH &mt RALT DOLLAR &mt RGUI AT
                &kp SPACE  &kp LANG1  &none       &kp QMARK       &kp BSPC      &kp TAB         &kp EXCL       &none       &kp LANG2  &kp DEL
                                                  &trans          &trans        &mo NAV_L       &kp ENTER
            >;
        };

        sym_layer {
            bindings = <
                &kp PIPE   &kp EQUAL   &kp TILDE   &kp PLUS       &kp LT        &kp GT          &kp CARET      &kp AMPS    &kp PRCNT  &kp ASTRK
        &mt LGUI BSLH &mt LALT LBKT &mt LSHFT LBRC &mt LCTRL LPAR &kp SEMI      &kp COLON       &mt RCTRL RPAR &mt RSHFT RBRC &mt RALT RBKT &mt RGUI SLASH
                &kp ENTER  &kp HOME    &kp DOWN    &kp UP         &kp BSPC      &kp TAB         &kp LEFT       &kp RIGHT   &kp END    &kp DEL
                                                   &kp SPACE      &mo NAV_L     &trans          &trans
            >;
        };

        nav_layer {
            bindings = <
                &kp F1     &kp F2     &kp F3      &kp F4          &kp F5       &kp F6           &kp F7         &kp F8      &kp F9     &kp F10
                &kp F11    &kp C_RW   &kp C_PREV  &kp C_STOP      &none        &none            &kp C_PLAY     &kp C_NEXT  &kp C_FF   &kp F12
                &none      &none      &kp C_BRI_DN &kp C_VOL_DN   &none        &none            &kp C_VOL_UP   &kp C_BRI_UP &none     &none
                                                  &none           &trans       &trans           &none
            >;
        };

    };
};
